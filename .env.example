# Local PostgreSQL started by docker-compose.yml (npm run db:up).
# Change the password and keep it in sync with DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=citecreate
DATABASE_URL="postgresql://postgres:change_me@localhost:54321/citecreate?schema=public"

# LLM providers: Gemini is the primary, Groq is the fallback.
GEMINI_API_KEY=
GROQ_API_KEY=

# Contact email required by the Unpaywall API.
UNPAYWALL_EMAIL=you@example.com

LOG_LEVEL=info
